# --- LLM : SSPCloud ou Ollama local ---
LLM_BASE_URL=https://llm.lab.sspcloud.fr/api
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3-8-27b
LLM_API_KEY=
LLM_TIMEOUT=60

# --- Juge d'injection (FO3) : second appel au LLM, en parallèle de la détection ---
# LLM_JUDGE_ENABLED=false désactive le juge (il double les appels au LLM)
# LLM_JUDGE_MODEL=   (par défaut : LLM_MODEL)
LLM_JUDGE_ENABLED=true
LLM_JUDGE_MODEL=

# --- Detecteur NER Spacy local ---
NER_ENABLED=False
# SPACY_MODEL=fr_core_news_lg

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public

# --- JWT (étape 4) ---
JWT_SECRET=

# --- Compte administrateur initial (créé au démarrage s'il n'existe pas) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
