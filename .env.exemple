# --- LLM : SSPCloud ou Ollama local ---
LLM_BASE_URL=https://llm.lab.sspcloud.fr/api
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3-8-27b
LLM_API_KEY=
LLM_TIMEOUT=60

# --- Juge d'injection (FO3) : second appel au LLM, en parallèle de la détection ---
# LLM_JUDGE_ENABLED=false désactive le juge (il double les appels au LLM)
# LLM_JUDGE_MODEL=   (par défaut : LLM_MODEL)
LLM_JUDGE_ENABLED=true
LLM_JUDGE_MODEL=

# --- Detecteur NER Spacy local ---
NER_ENABLED=False
# SPACY_MODEL=fr_core_news_lg

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SCHEMA=public

# --- JWT (étape 4) ---
JWT_SECRET=

# --- Compte administrateur initial (créé au démarrage s'il n'existe pas) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# --- Limitation des tentatives de connexion (anti force brute) ---
# Apres LOGIN_MAX_ECHECS echecs en LOGIN_FENETRE_SECONDES secondes, le login est bloque
# LOGIN_VERROUILLAGE_SECONDES secondes. LOGIN_MAX_ECHECS=0 desactive la limite.
LOGIN_MAX_ECHECS=5
LOGIN_FENETRE_SECONDES=900
LOGIN_VERROUILLAGE_SECONDES=900

# --- Tentatives d'injection de prompt par compte ---
# A partir de INJECTION_SEUIL_ALERTE documents suspects, le compte est signale aux administrateurs ;
# a partir de INJECTION_SEUIL_DESACTIVATION, il est desactive jusqu'a reactivation par un admin.
INJECTION_SEUIL_ALERTE=3
INJECTION_SEUIL_DESACTIVATION=10
